{
    "version": 3,
    "configurePresets": [
        {
            "name": "vcpkg",
            "displayName": "vcpkg Release with Clang",
            "description": "Release build with vcpkg dependencies using Clang-20",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang-20",
                "CMAKE_CXX_COMPILER": "clang++-20",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vcpkg",
            "displayName": "vcpkg Release Build with Clang",
            "description": "Build release configuration with vcpkg using Clang-20",
            "configurePreset": "vcpkg",
            "configuration": "Release"
        }
    ]
}